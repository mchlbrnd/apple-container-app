{
  "name": "apple-container-app-electron",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "description": "Electron wrapper for the ui React app",
  "scripts": {
    "dev": "concurrently -k \"npm --prefix ui run dev\" \"wait-on tcp:8080 && VITE_DEV_SERVER_URL=http://localhost:8080 electron .\"",
    "start": "electron .",
    "start:prod": "NODE_ENV=production electron .",
    "build:ui": "npm --prefix ui run build",
    "build": "npm run build:ui && electron-builder",
    "pack": "npm run build:ui && electron-builder --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^32.2.7",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.applecontainer.app",
    "productName": "Apple Container App",
    "files": [
      "electron/**/*",
      "ui/dist/**/*"
    ],
    "directories": {
      "buildResources": "build"
    },
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ]
    }
  }
}


